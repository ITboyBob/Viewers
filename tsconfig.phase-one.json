{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "checkJs": false,
    "skipLibCheck": true,
    "paths": {
      "@ohif/core": ["platform/core/src"],
      "@ohif/ui": ["platform/ui/src"],
      "@ohif/ui-next": ["platform/ui-next/src"],
      "@ohif/i18n": ["platform/i18n/src"],
      "@ohif/app": ["platform/app/src"],
      "@ohif/extension-default": ["./extensions/default/src"],
      "@ohif/extension-measurement-tracking": ["./extensions/measurement-tracking/src"],
      "@ohif/extension-cornerstone-dicom-sr": ["./extensions/cornerstone-dicom-sr/src"],
      "@ohif/extension-cornerstone-dicom-seg": ["./extensions/cornerstone-dicom-seg/src"],
      "@ohif/extension-ultrasound-pleura-bline": ["./extensions/usAnnotation/src"],
      "@ohif/mode-ultrasound-pleura-bline": ["./modes/usAnnotation/src"],
      "@ohif/extension-cornerstone": ["./extensions/cornerstone/src"],
      "@ohif/extension-dicom-pdf": ["./extensions/dicom-pdf/src"],
      "@state": ["./platform/app/src/state"],
      "@routes/*": ["platform/app/src/routes/*"],
      "@components/*": ["platform/app/src/components/*"],
      "@hooks/*": ["platform/app/src/hooks/*"],
      "@/*": ["platform/app/src/*"]
    }
  },
  "include": [
    "platform/core/src/types/AppTypes.ts",
    "platform/core/src/types/Services.ts",
    "platform/core/src/index.ts",
    "platform/app/src/business/**/*.ts",
    "platform/app/src/business/**/*.tsx",
    "platform/app/src/routes/Account/**/*.ts",
    "platform/app/src/routes/Account/**/*.tsx",
    "platform/app/src/routes/index.tsx",
    "platform/app/src/routes/buildModeRoutes.tsx",
    "platform/app/src/routes/Local/**/*.ts",
    "platform/app/src/routes/Local/**/*.tsx",
    "platform/app/src/routes/Mode/Mode.tsx",
    "platform/app/src/App.tsx",
    "playwright.phase-one.config.ts",
    "tests/phase-one/**/*.ts",
    "extensions/default/src/ViewerLayout/ViewerHeader.tsx",
    "platform/ui-next/src/components/Header/Header.tsx"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"],
  "files": ["platform/app/src/business/BusinessContracts.test.ts"]
}
